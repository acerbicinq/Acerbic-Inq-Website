---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { client, urlFor } from "../../lib/sanity";
import PortableText from "../../components/PortableText.jsx";

export async function getStaticPaths() {
  const bookPosts = await client.fetch(`
    *[_type == "bookContent"] {
      slug,
      title
    }
  `);
  
  return bookPosts.map((post) => ({
    params: { slug: post.slug.current },
  }));
}

const { slug } = Astro.params;

const bookPost = await client.fetch(`
  *[_type == "bookContent" && slug.current == $slug][0] {
    _id,
    title,
    slug,
    publishedAt,
    description,
    coverImage,
    contentType,
    status,
    genre,
    readingSettings,
    accessibilitySettings,
    chapters[]{
      chapterTitle,
      chapterNumber,
      chapterSlug,
      summary,
      content,
      wordCount,
      publishedAt
    },
    totalWordCount,
    dedication,
    acknowledgments,
    authorNotes,
    purchaseLinks,
    tags,
    series,
    isbn
  }
`, { slug });

if (!bookPost) {
  return Astro.redirect("/404");
}

const pageTitle = bookPost.title;

// Determine the back link based on content type
let backLink = "/writing";
let backText = "← Back to Writing";
if (bookPost.contentType === "book") {
  backLink = "/novels";
  backText = "← Back to Novels";
} else if (bookPost.contentType === "short-story") {
  backLink = "/shorts";
  backText = "← Back to Short Stories";
} else if (bookPost.contentType === "magazine") {
  backLink = "/magazine";  
  backText = "← Back to Magazine";
}
---

<BaseLayout pageTitle={pageTitle}>
  <article class="book-post-detail">

    
    {bookPost.purchaseLinks && bookPost.purchaseLinks.length > 0 && (
      <div class="purchase-section">
        <h2>Get This {bookPost.contentType === 'book' ? 'Book' : bookPost.contentType === 'short-story' ? 'Story' : 'Content'}</h2>
        <div class="purchase-links">
          {bookPost.purchaseLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="purchase-link">
              {link.platform.charAt(0).toUpperCase() + link.platform.slice(1).replace('-', ' ')}
              {link.price && <span class="price">{link.price}</span>}
            </a>
          ))}
        </div>
      </div>
    )}
    
    {bookPost.dedication && (
      <div class="dedication-section">
        <h2>Dedication</h2>
        <p class="dedication">{bookPost.dedication}</p>
      </div>
    )}
    
    {bookPost.chapters && bookPost.chapters.length > 0 && bookPost.readingSettings?.allowFullRead && (
      <div class="chapters-section">
        
        <div class="chapters-list">
          {bookPost.chapters.map((chapter) => (
            <div class="chapter-item">
              <h3>Chapter {chapter.chapterNumber}: {chapter.chapterTitle}</h3>
              {chapter.summary && (
                <p class="chapter-summary">{chapter.summary}</p>
              )}
              {chapter.wordCount && (
                <p class="chapter-word-count">~{chapter.wordCount.toLocaleString()} words</p>
              )}
              {chapter.content && (
                <div class="chapter-content">
                  <PortableText value={chapter.content} client:load />
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    )}
    
    {bookPost.chapters && bookPost.chapters.length > 0 && !bookPost.readingSettings?.allowFullRead && (
      <div class="chapters-preview">
        <h2>Table of Contents</h2>
        <div class="chapters-list-preview">
          {bookPost.chapters.map((chapter) => (
            <div class="chapter-preview">
              <h3>Chapter {chapter.chapterNumber}: {chapter.chapterTitle}</h3>
              {chapter.summary && (
                <p class="chapter-summary">{chapter.summary}</p>
              )}
              {chapter.wordCount && (
                <p class="chapter-word-count">~{chapter.wordCount.toLocaleString()} words</p>
              )}
            </div>
          ))}
        </div>
        <p class="preview-note">Full content available for purchase.</p>
      </div>
    )}
    
    {bookPost.authorNotes && (
      <div class="author-notes-section">
        <h2>Author's Notes</h2>
        <div class="author-notes">
          <PortableText value={bookPost.authorNotes} client:load />
        </div>
      </div>
    )}
    
    {bookPost.acknowledgments && (
      <div class="acknowledgments-section">
        <h2>Acknowledgments</h2>
        <div class="acknowledgments">
          <PortableText value={bookPost.acknowledgments} client:load />
        </div>
      </div>
    )}

    <nav class="post-navigation">
      <a href={backLink} class="back-link">{backText}</a>
    </nav>
  </article>
</BaseLayout>

